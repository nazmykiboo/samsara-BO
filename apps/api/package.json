  },
  "dependencies": {
    "@samsara/core": "*",
    "@samsara/hr": "*",
    "@samsara/inventory": "*",
    "@samsara/sales-sync": "*",
    "dotenv": "^16.4.7",
    "express": "^4.21.1"
  }
}
