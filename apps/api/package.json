{
  "name": "@samsara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "import:harga-jual": "tsx src/import-harga-jual.ts",
    "seed:owner": "tsx src/seed-owner.ts",
    "seed:integrasi": "tsx src/seed-integrasi.ts",
