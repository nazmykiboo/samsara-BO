    {
      "id": "abc9e6c9-4a3a-4255-8d95-48cc6c14c41d",
      "name": "Parse Token Majoo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -60
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json.token;\nconst parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\nreturn [{ json: { access_token: parsed.token } }];"
      }
    },
    {
      "id": "e85f8fef-d425-4342-acb9-ca70a07d9ce9",
      "name": "Tentukan Rentang Tanggal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -60
      ],
      "parameters": {
        "jsCode": "// Rentang [hari ini - windowDays, hari ini], jam dinding WIB (UTC+7) --\n// windowDays datang dari 'Simpan Token & Mode' (2 hari jadwal otomatis,\n// 1 hari dry-run manual), pola SAMA seperti 'Atur Mode' di workflow ini\n// dan 'Generate Date Chunks' mode 'daily' di workflow 'Majoo - Sales'\n// (database n8n) yang jadi rujukan logika ini -- TANPA mode backfill\n// manual (itu cuma dipakai sekali saat setup, bukan jadwal rutin).\n//\n// Akumulator baris sales di-reset di sini (sekali per eksekusi workflow,\n// node ini cuma jalan sekali per run) -- dibaca ulang nanti di 'Ambil\n// Baris Sales Terkumpul' setelah loop halaman selesai. Pola static data\n// dipakai karena loop manual (If/Wait/Set) di n8n TIDAK otomatis\n// mengumpulkan output tiap iterasi jadi satu daftar -- beda dari\n// workflow 'Majoo - Sales' yang tidak perlu akumulasi karena tiap\n// halaman langsung ditulis ke Google Sheets saat itu juga (append\n// per-halaman). Di sini butuh SEMUA baris terkumpul dulu sebelum masuk\n// ke 'Susun CSV & Pecah Batch' (desainnya menerima semua baris sekaligus,\n// sama seperti saat sumbernya pembacaan Google Sheets utuh).\n$getWorkflowStaticData('node').barisSalesMajoo = [];\n\nconst windowDays = $('Simpan Token & Mode').first().json.windowDays;\nconst access_token = $json.access_token;\n\nconst nowUTC = new Date();\nconst wibNow = new Date(nowUTC.getTime() + 7 * 3600 * 1000);\nconst today = new Date(Date.UTC(wibNow.getUTCFullYear(), wibNow.getUTCMonth(), wibNow.getUTCDate()));\n\nconst start = new Date(today);\nstart.setUTCDate(start.getUTCDate() - windowDays);\n\nconst pad = n => String(n).padStart(2, '0');\nconst fmt = (d, endOfDay) => {\n  const y = d.getUTCFullYear();\n  const m = pad(d.getUTCMonth() + 1);\n  const day = pad(d.getUTCDate());\n  return endOfDay ? `${y}-${m}-${day} 23:59` : `${y}-${m}-${day} 00:00`;\n};\n\nreturn [{ json: {\n  start_date: fmt(start, false),\n  end_date: fmt(today, true),\n  access_token,\n} }];"
      }
    },
