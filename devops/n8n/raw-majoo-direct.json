        "jsCode": "// Loop halaman selesai ('Ada Halaman Lagi?' cabang 'tidak') -- baca\n// balik akumulator yang diisi 'Petakan Baris Sales' tiap iterasi.\nconst sd = $getWorkflowStaticData('node');\nconst baris = sd.barisSalesMajoo || [];\nreturn baris.map(b => ({ json: b }));"
