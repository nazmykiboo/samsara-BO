    {
      "id": "497f877d-b264-4350-9439-cc81c18de9a1",
      "name": "Petakan Baris Sales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -220
      ],
      "parameters": {
        "jsCode": "// Baris 'sales' satu halaman -> 20 kolom KOLOM_MAJOO\n// (modules/sales-sync/src/domain/import-csv.ts:527-546), LANGSUNG\n// ditambahkan ke akumulator statis (bukan cuma di-return) -- node ini\n// jalan ulang tiap iterasi loop halaman, outputnya sendiri cuma dipakai\n// untuk debug per-halaman, sumber kebenarannya akumulator di\n// 'Ambil Baris Sales Terkumpul'. Kolom refund_* dikosongkan di sini --\n// diisi 'Petakan Baris Refund' untuk baris dari endpoint refund_sales.\nconst merged = $input.first().json;\nconst items = merged.data || [];\n\nconst baris = items.map(t => ({\n  id: t.id,\n  transaction_no: t.transaction_no,\n  transaction_date: t.transaction_date,\n  payment_date: t.payment_date,\n  order_type_name: t.order_type_name,\n  payment_method_name: t.payment_method_name,\n  payment_cashier_name: t.payment_cashier_name,\n  total_sales: t.total_sales,\n  receivables: t.receivables,\n  total_discount_amount: t.total_discount_amount,\n  refund_amount: t.refund_amount,\n  is_paid: t.is_paid,\n  outlet_id: t.outlet_id,\n  hasMore: '',\n  nextPage: '',\n  _empty: '',\n  refund_id: '',\n  refund_no: '',\n  refund_date: '',\n  refund_reason: '',\n}));\n\nconst sd = $getWorkflowStaticData('node');\nsd.barisSalesMajoo = (sd.barisSalesMajoo || []).concat(baris);\n\nreturn [{ json: { jumlahDitambahkan: baris.length, totalSejauhIni: sd.barisSalesMajoo.length } }];"
      }
    },
    {
      "id": "066ed9b4-0ced-48e1-bc5a-70b03caea3e4",
      "name": "Loop Control Sales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        60
      ],
      "parameters": {
        "jsCode": "const limit = 100;\nconst merged = $input.first().json;\nconst items = merged.data || [];\n\nreturn [{\n  json: {\n    hasMore: items.length === limit,\n    nextPage: merged.page + 1,\n    access_token: merged.access_token,\n    start_date: merged.start_date,\n    end_date: merged.end_date\n  }\n}];"
      }
    },
