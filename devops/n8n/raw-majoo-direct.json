    },
    {
      "id": "65a5a35a-1b69-465c-85e8-2146a4066eaa",
      "name": "Parse Token Majoo (Refund)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json.token;\nconst parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\nreturn [{ json: { access_token: parsed.token } }];"
      }
    },
    {
      "id": "7b2f99b7-8358-4a4e-bb79-2bcbfdddfe43",
      "name": "Siapkan Request Refund",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "jsCode": "// Jendela sama persis dengan 'Tentukan Rentang Tanggal' (sales), tapi\n// refund_sales cuma terima tanggal polos YYYY-MM-DD (tanpa jam) -- lihat\n// 'Get Refund Sales' di workflow 'Majoo - Sales' (database n8n), format\n// aslinya memang begitu di sana.\nconst windowDays = $('Simpan Token & Mode').first().json.windowDays;\nconst access_token = $json.access_token;\n\nconst nowUTC = new Date();\nconst wibNow = new Date(nowUTC.getTime() + 7 * 3600 * 1000);\nconst today = new Date(Date.UTC(wibNow.getUTCFullYear(), wibNow.getUTCMonth(), wibNow.getUTCDate()));\nconst start = new Date(today);\nstart.setUTCDate(start.getUTCDate() - windowDays);\n\nconst pad = n => String(n).padStart(2, '0');\nconst fmt = d => `${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())}`;\n\nreturn [{ json: { start_date: fmt(start), end_date: fmt(today), page: 1, access_token } }];"
      }
    },
    {
      "id": "8efae001-7045-468a-830b-c9e7cad3b113",
      "name": "Get Refund Sales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        420
      ],
      "parameters": {
        "url": "https://services.majoo.id/svc-data-reporting/api/v4/refund_sales",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "start_date",
              "value": "={{ $json.start_date }}"
            },
            {
              "name": "end_date",
              "value": "={{ $json.end_date }}"
            },
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "page",
              "value": "={{ $json.page }}"
            },
            {
              "name": "template_id",
              "value": "0"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={\"authorization\": \"Bearer {{ $json.access_token }}\", \"content-type\": \"application/json\", \"origin\": \"https://dashboard.majoo.id\", \"referer\": \"https://dashboard.majoo.id/\", \"x-brand-key\": \"undefined\", \"accept\": \"*/*\"}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "567b7752-b0e3-4115-b89f-c5758a125d07",
      "name": "Petakan Baris Refund",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        420
      ],
      "parameters": {
        "jsCode": "// Baris 'refund' -> 20 kolom KOLOM_MAJOO. Kolom sales dikosongkan --\n// transaction_no dipakai sebagai field gabung ke baris sales terkait\n// (join dilakukan di sisi pembaca laporan, BUKAN di sini -- sama\n// seperti perilaku 'Format Refund Rows' yang sudah ada).\nconst items = $input.first().json.data || [];\n\nreturn items.map(r => ({ json: {\n  id: '',\n  transaction_no: r.no_transaksi_penjualan,\n  transaction_date: '',\n  payment_date: '',\n  order_type_name: '',\n  payment_method_name: '',\n  payment_cashier_name: '',\n  total_sales: '',\n  receivables: '',\n  total_discount_amount: '',\n  refund_amount: r.refund_rp,\n  is_paid: '',\n  outlet_id: '',\n  hasMore: '',\n  nextPage: '',\n  _empty: '',\n  refund_id: r.id,\n  refund_no: r.no_transaksi_refund,\n  refund_date: r.tanggal,\n  refund_reason: r.alasan_refund || '',\n} }));"
      }
    },
    {
      "id": "c9ad9004-831e-43c5-bd9d-3445e728b656",
      "name": "Gabung Semua Baris",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2860,
        280
      ],
      "parameters": {
        "mode": "append",
        "options": {}
      }
    },
    {
      "id": "fd492481-a823-48b5-abff-5577801c72a4",
      "name": "Susun CSV & Pecah Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function csvField(v) {\n  const s = v === null || v === undefined ? \"\" : String(v);\n  return /[\\\",\\n\\r]/.test(s) ? '\"' + s.replace(/\\\"/g, '\"\"') + '\"' : s;\n}\nfunction buatBarisCsv(header, obj) {\n  return header.map((h) => csvField(obj[h])).join(\",\");\n}\n\nconst mode = $('Simpan Token & Mode').first().json;\nconst { dryRun, token } = mode;\nconst HEADER = [\"id\",\"transaction_no\",\"transaction_date\",\"payment_date\",\"order_type_name\",\"payment_method_name\",\"payment_cashier_name\",\"total_sales\",\"receivables\",\"total_discount_amount\",\"refund_amount\",\"is_paid\",\"outlet_id\",\"hasMore\",\"nextPage\",\"_empty\",\"refund_id\",\"refund_no\",\"refund_date\",\"refund_reason\"];\nconst MAKS_BARIS = 30000;\n\nconst PETA = {\n  id: \"id\", transaction_no: \"transaction_no\", transaction_date: \"transaction_date\",\n  payment_date: \"payment_date\", order_type_name: \"order_type_name\",\n  payment_method_name: \"payment_method_name\", payment_cashier_name: \"payment_cashier_name\",\n  total_sales: \"total_sales\", receivables: \"receivables\",\n  total_discount_amount: \"total_discount_amount\", refund_amount: \"refund_amount\",\n  is_paid: \"is_paid\", outlet_id: \"outlet_id\", hasMore: \"hasMore\", nextPage: \"nextPage\",\n  _empty: \"_empty\", refund_id: \"refund_id\", refund_no: \"refund_no\",\n  refund_date: \"refund_date\", refund_reason: \"refund_reason\",\n};\n\n// TIDAK ada filter tanggal cutoff di sini -- beda sengaja dari\n// raw-majoo.json, lihat catatan di atas blok ini.\nconst baris = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const obj = {};\n  for (const kolom of HEADER) obj[kolom] = row[PETA[kolom]] ?? \"\";\n  baris.push(obj);\n}\n\nif (dryRun) {\n  return [{\n    json: {\n      dryRun: true,\n      jumlahBaris: baris.length,\n      contohBaris: baris.slice(0, 3),\n      csvHeader: HEADER.join(\",\"),\n    },\n  }];\n}\n\nconst hasil = [];\nfor (let i = 0; i < baris.length; i += MAKS_BARIS) {\n  const potongan = baris.slice(i, i + MAKS_BARIS);\n  const lines = [HEADER.join(\",\")];\n  for (const obj of potongan) lines.push(buatBarisCsv(HEADER, obj));\n  hasil.push({\n    json: {\n      dryRun: false,\n      token,\n      csvText: lines.join(\"\\n\") + \"\\n\",\n      jumlahBarisBatch: potongan.length,\n      batchKe: Math.floor(i / MAKS_BARIS) + 1,\n    },\n  });\n}\nif (hasil.length === 0) {\n  hasil.push({ json: { dryRun: false, token, csvText: HEADER.join(\",\") + \"\\n\", jumlahBarisBatch: 0, batchKe: 1 } });\n}\nreturn hasil;"
      }
    },
