    {
      "id": "6a79f085-6246-4d3d-ad92-df8e7ffd2b6c",
      "position": [
        1100,
        100
      ],
      "name": "Susun CSV & Pecah Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function csvField(v) {\n  const s = v === null || v === undefined ? \"\" : String(v);\n  return /[\",\\n\\r]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s;\n}\nfunction buatBarisCsv(header, obj) {\n  return header.map((h) => csvField(obj[h])).join(\",\");\n}\nfunction parseTanggalFleksibel(raw) {\n  if (raw === null || raw === undefined || raw === \"\") return null;\n  const s = String(raw).trim();\n  let m = /^(\\d{4})-(\\d{2})-(\\d{2})(?:[ T](\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?/.exec(s);\n  if (m) return Date.UTC(+m[1], +m[2] - 1, +m[3], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0));\n  m = /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})(?:[ T](\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?/.exec(s);\n  if (m) return Date.UTC(+m[3], +m[1] - 1, +m[2], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0));\n  return null;\n}\n// \"Sekarang\" dalam jam dinding Asia/Jakarta, dihitung sebagai UTC+0 palsu\n// supaya bisa dibandingkan apple-to-apple dengan parseTanggalFleksibel (yang\n// juga membaca digit jam mentah TANPA konversi timezone apa pun) -- cukup\n// akurat untuk jendela lookback per hari, TIDAK dipakai untuk simpan ke DB.\nfunction sekarangJakartaMs() {\n  return Date.now() + 7 * 60 * 60 * 1000;\n}\n\nconst mode = $('Simpan Token & Mode').first().json;\nconst { dryRun, windowDays, token } = mode;\nconst HEADER = [\"platform\",\"platform_order_number\",\"platform_transaction_id\",\"order_time\",\"settled_time\",\"status\",\"gross_amount\",\"total_fees\",\"net_revenue\",\"currency\",\"source\",\"source_id\",\"raw_payload\"];\nconst MAKS_BARIS = 10000;\n\nconst cutoffMs = sekarangJakartaMs() - windowDays * 24 * 60 * 60 * 1000;\n\nconst PETA = {\n  platform: \"platform\",\n  platform_order_number: \"platform_order_number\",\n  platform_transaction_id: \"platform_transaction_id\",\n  order_time: \"order_time\",\n  settled_time: \"settled_time\",\n  status: \"status\",\n  gross_amount: \"gross_amount\",\n  total_fees: \"total_fees\",\n  net_revenue: \"net_revenue\",\n  currency: \"currency\",\n  source: \"source\",\n  source_id: \"source_id\",\n  raw_payload: \"raw_payload\",\n};\n\nconst barisTerfilter = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const ms = parseTanggalFleksibel(row[PETA.order_time]);\n  if (ms === null || ms < cutoffMs) continue;\n  const obj = {};\n  for (const kolom of HEADER) obj[kolom] = row[PETA[kolom]] ?? \"\";\n  if (!obj.currency) obj.currency = \"IDR\";\n  barisTerfilter.push(obj);\n}\n\nif (dryRun) {\n  return [{\n    json: {\n      dryRun: true,\n      jumlahBaris: barisTerfilter.length,\n      contohBaris: barisTerfilter.slice(0, 3),\n      csvHeader: HEADER.join(\",\"),\n    },\n  }];\n}\n\nconst hasil = [];\nfor (let i = 0; i < barisTerfilter.length; i += MAKS_BARIS) {\n  const potongan = barisTerfilter.slice(i, i + MAKS_BARIS);\n  const lines = [HEADER.join(\",\")];\n  for (const obj of potongan) lines.push(buatBarisCsv(HEADER, obj));\n  hasil.push({\n    json: {\n      dryRun: false,\n      token,\n      csvText: lines.join(\"\\n\") + \"\\n\",\n      jumlahBarisBatch: potongan.length,\n      batchKe: Math.floor(i / MAKS_BARIS) + 1,\n    },\n  });\n}\nif (hasil.length === 0) {\n  hasil.push({ json: { dryRun: false, token, csvText: HEADER.join(\",\") + \"\\n\", jumlahBarisBatch: 0, batchKe: 1 } });\n}\nreturn hasil;"
      }
    },
