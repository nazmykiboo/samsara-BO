    {
      "id": "5699dc15-883b-40dc-b858-336d73fed884",
      "position": [
        1100,
        100
      ],
      "name": "Susun CSV & Pecah Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function csvField(v) {\n  const s = v === null || v === undefined ? \"\" : String(v);\n  return /[\",\\n\\r]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s;\n}\nfunction buatBarisCsv(header, obj) {\n  return header.map((h) => csvField(obj[h])).join(\",\");\n}\nfunction parseTanggalFleksibel(raw) {\n  if (raw === null || raw === undefined || raw === \"\") return null;\n  const s = String(raw).trim();\n  let m = /^(\\d{4})-(\\d{2})-(\\d{2})(?:[ T](\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?/.exec(s);\n  if (m) return Date.UTC(+m[1], +m[2] - 1, +m[3], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0));\n  m = /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})(?:[ T](\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?/.exec(s);\n  if (m) return Date.UTC(+m[3], +m[1] - 1, +m[2], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0));\n  return null;\n}\n// \"Sekarang\" dalam jam dinding Asia/Jakarta, dihitung sebagai UTC+0 palsu\n// supaya bisa dibandingkan apple-to-apple dengan parseTanggalFleksibel (yang\n// juga membaca digit jam mentah TANPA konversi timezone apa pun) -- cukup\n// akurat untuk jendela lookback per hari, TIDAK dipakai untuk simpan ke DB.\nfunction sekarangJakartaMs() {\n  return Date.now() + 7 * 60 * 60 * 1000;\n}\n\nconst mode = $('Simpan Token & Mode').first().json;\nconst { dryRun, windowDays, token } = mode;\nconst HEADER = [\"transaction_date\",\"transaction_time\",\"platform\",\"order_id\",\"item_name\",\"menu_id\",\"quantity\",\"item_type\",\"parent_item\",\"unique_key\",\"inv_status\"];\nconst MAKS_BARIS = 50000;\n\nconst cutoffMs = sekarangJakartaMs() - windowDays * 24 * 60 * 60 * 1000;\n\n// PETA KOLOM -- kalau nama kolom di tab Google Sheet \"LOG_PENJUALAN\" beda\n// dari asumsi di sini (sisi kiri = nama target CSV, sisi kanan = nama kolom\n// SUMBER di sheet), ubah sisi kanannya saja. Lihat README § \"Kalau mapping\n// kolom salah\".\nconst PETA = {\n  transaction_date: \"transaction_date\",\n  transaction_time: \"transaction_time\",\n  platform: \"platform\",\n  order_id: \"order_id\",\n  item_name: \"item_name\",\n  menu_id: \"menu_id\",\n  quantity: \"quantity\",\n  item_type: \"item_type\",\n  parent_item: \"parent_item\",\n  unique_key: \"unique_key\",\n  inv_status: \"inv_status\",\n};\n\nconst barisTerfilter = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const ms = parseTanggalFleksibel(row[PETA.transaction_date]);\n  if (ms === null || ms < cutoffMs) continue;\n  const obj = {};\n  for (const kolom of HEADER) {\n    obj[kolom] = row[PETA[kolom]] ?? \"\";\n  }\n  // Sheet LOG_PENJUALAN tidak punya konsep inv_status -- semua baris yang ada\n  // di sana memang penjualan selesai, defaultkan 'OK' kalau kosong.\n  if (!obj.inv_status) obj.inv_status = \"OK\";\n  barisTerfilter.push(obj);\n}\n\nif (dryRun) {\n  return [{\n    json: {\n      dryRun: true,\n      jumlahBaris: barisTerfilter.length,\n      contohBaris: barisTerfilter.slice(0, 3),\n      csvHeader: HEADER.join(\",\"),\n    },\n  }];\n}\n\nconst hasil = [];\nfor (let i = 0; i < barisTerfilter.length; i += MAKS_BARIS) {\n  const potongan = barisTerfilter.slice(i, i + MAKS_BARIS);\n  const lines = [HEADER.join(\",\")];\n  for (const obj of potongan) lines.push(buatBarisCsv(HEADER, obj));\n  hasil.push({\n    json: {\n      dryRun: false,\n      token,\n      csvText: lines.join(\"\\n\") + \"\\n\",\n      jumlahBarisBatch: potongan.length,\n      batchKe: Math.floor(i / MAKS_BARIS) + 1,\n    },\n  });\n}\nif (hasil.length === 0) {\n  hasil.push({ json: { dryRun: false, token, csvText: HEADER.join(\",\") + \"\\n\", jumlahBarisBatch: 0, batchKe: 1 } });\n}\nreturn hasil;"
      }
    },
