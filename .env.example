# Salin file ini ke .env. Database: PostgreSQL native (bukan Docker/MAMP),
# terinstal langsung di mesin lokal (mis. `brew install postgresql@16`),
# jalan di localhost dengan port default. Lihat README.md § Quickstart untuk
# cara membuat role + database `samsara`-nya kalau belum ada.

DB_HOST=localhost
DB_PORT=5432
DB_USER=samsara
DB_PASSWORD=
DB_NAME=samsara

PORT=4000

# Auth (wajib diisi -- TIDAK ADA nilai default di kode, sengaja).
# AUTH_JWT_SECRET: string acak panjang untuk menandatangani token login,
#   generate sendiri mis. `openssl rand -hex 32`. Ganti isinya untuk tiap
#   environment (jangan pakai nilai yang sama di dev & production nanti).
# AUTH_SEED_OWNER_USERNAME / AUTH_SEED_OWNER_PASSWORD: dipakai SEKALI oleh
#   `npm run seed:owner` untuk membuat user owner pertama. Password TIDAK
#   pernah ditulis di kode/repo -- isi di .env lokal kamu sendiri (file
#   .env sudah di .gitignore).
AUTH_JWT_SECRET=
AUTH_SEED_OWNER_USERNAME=owner
AUTH_SEED_OWNER_PASSWORD=
